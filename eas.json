{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "environment": "development",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "device": {
      "extends": "development",
      "ios": {
        "simulator": false
      },
      "channel": "device"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "aeghin7@gmail.com",
        "appleTeamId": "XYM362M868",
        "bundleIdentifier": "com.aeghinsteam.aeghin"
      }
    }
  }
}
